{
  "name": "stride",
  "version": "1.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest --runInBand",
    "doctor": "npx expo-doctor",
    "check:conflicts": "node scripts/check-conflicts.mjs",
    "verify": "npm run check:conflicts && npm run typecheck && npm run lint && npm test && npm run doctor"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@supabase/supabase-js": "^2.57.4",
    "expo": "~54.0.0",
    "expo-dev-client": "~6.0.10",
    "expo-haptics": "~15.0.7",
    "expo-keep-awake": "~15.0.7",
    "expo-linear-gradient": "~15.0.7",
    "expo-location": "~19.0.7",
    "expo-sensors": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "expo-task-manager": "~14.0.7",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.6",
    "@types/react": "~19.1.10",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "typescript": "~5.9.2"
  },
  "jest": { "preset": "jest-expo", "testMatch": ["**/__tests__/**/*.test.ts"] }
}
