+function BigStat({ label, value, c }: { label: string; value: string; c: Palette }) { return <View style={s.bigStat}><Text numberOfLines={1} adjustsFontSizeToFit style={[s.bigValue, { color: c.text }]}>{value}</Text><Text style={[s.statLabel, { color: c.muted }]}>{label}</Text></View>; }
+const s = StyleSheet.create({ center: { flex: 1, alignItems: '\''center'\'', justifyContent: '\''center'\'', padding: 24 }, close: { position: '\''absolute'\'', top: 60, right: 24, zIndex: 2 }, readyOrb: { width: 112, height: 112, borderRadius: 40, alignItems: '\''center'\'', justifyContent: '\''center'\'' }, readyTitle: { fontSize: 29, fontWeight: '\''800'\'', letterSpacing: -.7, textAlign: '\''center'\'', marginTop: 24 }, readyBody: { fontSize: 15, lineHeight: 23, textAlign: '\''center'\'', maxWidth: 340, marginTop: 10 }, action: { position: '\''absolute'\'', bottom: 46, left: 24, right: 24, gap: 18 }, cancel: { fontSize: 15, fontWeight: '\''700'\'', textAlign: '\''center'\'' }, complete: { width: 76, height: 76, borderRadius: 30, alignItems: '\''center'\'', justifyContent: '\''center'\'' }, summaryCard: { width: '\''100%'\'', borderRadius: 26, borderWidth: 1, padding: 22, marginTop: 35, gap: 24 }, bigStat: { flex: 1, alignItems: '\''center'\'', minWidth: 0 }, bigValue: { fontSize: 19, fontWeight: '\''800'\'' }, statLabel: { fontSize: 9, fontWeight: '\''800'\'', letterSpacing: .8, marginTop: 6 }, live: { flex: 1 }, livePill: { position: '\''absolute'\'', top: 58, alignSelf: '\''center'\'', paddingHorizontal: 17, height: 38, borderRadius: 19, flexDirection: '\''row'\'', alignItems: '\''center'\'', gap: 8 }, dot: { width: 7, height: 7, borderRadius: 4 }, liveCard: { position: '\''absolute'\'', left: 14, right: 14, bottom: 24, borderRadius: tokens.radius.xl, borderWidth: 1, padding: 22, alignItems: '\''center'\'' }, timer: { fontSize: 42, fontWeight: '\''700'\'', fontVariant: ['\''tabular-nums'\''] }, elapsed: { fontSize: 10, fontWeight: '\''800'\'', letterSpacing: 1, marginTop: 2 }, signal: { fontSize: 11, marginTop: 8, textAlign: '\''center'\'' }, liveStats: { flexDirection: '\''row'\'', width: '\''100%'\'', marginVertical: 22 }, controls: { flexDirection: '\''row'\'', gap: 20 }, round: { width: 60, height: 60, borderRadius: 30, alignItems: '\''center'\'', justify