+  const route = walk?.route ?? [], initial = route.at(-1);
+  return <View style={[s.live, { backgroundColor: c.map }]}>{initial ? <MapView ref={mapRef} style={StyleSheet.absoluteFill} initialRegion={{ ...initial, latitudeDelta: .012, longitudeDelta: .012 }} userInterfaceStyle={c.bg === '\''#07100C'\'' ? '\''dark'\'' : '\''light'\''} showsUserLocation showsMyLocationButton={false}><Polyline coordinates={route} strokeColor={c.primary} strokeWidth={6}/><Marker coordinate={initial}><LinearGradient colors={[c.primary, c.primary2]} style={s.marker}><View style={s.markerCore}/></LinearGradient></Marker></MapView> : null}<LinearGradient colors={[c.surface, c.surface2]} style={s.livePill}><View style={[s.dot, { backgroundColor: phase === '\''paused'\'' ? c.warning : signalLost ? c.danger : c.primary }]}/><Text style={{ color: c.text, fontWeight: '\''800'\'' }}>{phase === '\''paused'\'' ? '\''PAUSED'\'' : signalLost ? '\''GPS SIGNAL LOST'\'' : '\''RECORDING'\''}</Text></LinearGradient><LinearGradient colors={[c.surface, c.surface2]} style={[s.liveCard, { borderColor: c.line }]}><Text style={[s.timer, { color: c.text }]}>{formatDuration(elapsed)}</Text><Text style={[s.elapsed, { color: c.muted }]}>ACTIVE TIME</Text>{signalLost ? <Text style={[s.signal, { color: c.danger }]}>Keep walking outdoors—Stride will reconnect automatically.</Text> : null}<View style={s.liveStats}><BigStat label="DISTANCE" value={formatDistance(distance, units)} c={c}/><BigStat label="CURRENT PACE" value={currentPace} c={c}/><BigStat label="AVG. PACE" value={pace(distance, elapsed, units)} c={c}/></View><View style={s.controls}><Pressable accessibilityLabel={phase === '\''paused'\'' ? '\''Resume walk'\'' : '\''Pause walk'\''} onPress={phase === '\''paused'\'' ? resume : pause} style={[s.round, { backgroundColor: c.elevated }]}><Ionicons name={phase === '\''paused'\'' ? '\''play'\'' : '\''pause'\''} size={26} color={c.text}/></Pressable><Pressable accessibilityLabel="Finish walk" onPress={() => Alert.alert('\''Finish walk?'\'', '\''Your current route will be ready to save.'\'', [{ text: '\''Keep walking'\'', style: '\''cancel'\'' }, { text: '\''Finish'\'', onPress: finish }])} style={s.round}><LinearGradient colors={[c.danger, '\''#C94058'\'']} style={s.round}><Ionicons name="stop" size={25} color="white"/></LinearGradient></Pressable></View></LinearGradient></View>;
