+    "orientation": "portrait",
+    "userInterfaceStyle": "automatic",
+    "icon": "./assets/icon.png",
+    "splash": { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#09120E" },
+    "ios": {
+      "supportsTablet": false,
+      "bundleIdentifier": "com.stridehealth.walktracker",
+      "buildNumber": "2",
+      "infoPlist": {
+        "NSMotionUsageDescription": "Stride reads motion activity to show your daily step count.",
+        "NSLocationWhenInUseUsageDescription": "Stride uses your location to map and measure walks that you choose to record.",
+        "NSLocationAlwaysAndWhenInUseUsageDescription": "Stride can continue recording an active walk when the screen is locked or another app is open.",
+        "UIBackgroundModes": ["location"]
+      }
+    },
+    "android": {
+      "package": "com.stridehealth.walktracker",
+      "versionCode": 2,
+      "permissions": ["ACTIVITY_RECOGNITION", "ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "ACCESS_BACKGROUND_LOCATION", "FOREGROUND_SERVICE", "FOREGROUND_SERVICE_LOCATION"],
+      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#09120E" }
+    },
+    "plugins": [
+      ["expo-location", { "locationWhenInUsePermission": "Allow Stride to map and measure walks you record.", "locationAlwaysAndWhenInUsePermission": "Allow Stride to keep recording an active walk when the screen is locked." }],
+      "expo-sensors",
+      "expo-task-manager"
+    ],
+    "extra": { "eas": { "projectId": "REPLACE_WITH_EAS_PROJECT_ID" } }
+  }
+}
